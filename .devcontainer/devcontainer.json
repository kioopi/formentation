{
  "name": "Formentation",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "jakebecker.elixir-ls",
        "phoenixframework.phoenix",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [4000],
  "postCreateCommand": "mise trust && mise install && mix local.hex --force && mix local.rebar --force && mix deps.get && mise run playwright-browsers",
  "remoteEnv": {
    "MIX_ENV": "dev"
  }
}
